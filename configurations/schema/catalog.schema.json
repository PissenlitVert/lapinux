{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/PissenlitVert/lapinux-configurations/main/schema/catalog.schema.json",
  "title": "Lapinux configuration catalog",
  "description": "Generated by tools/catalog.py. Do not edit catalog.json by hand. Each entry is a configuration manifest plus the generated 'base' and 'size' fields.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "maintainer", "configurations"],
  "properties": {
    "version": {
      "const": 2,
      "description": "Catalog format. Lapinux accepts older catalogs but always publishes version 2."
    },
    "maintainer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "github": { "type": "string", "pattern": "^[A-Za-z0-9-]+$" }
      }
    },
    "configurations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "type", "platform", "author", "version", "license", "game", "actions", "base"],
        "properties": {
          "base": {
            "type": "string",
            "pattern": "^configurations/[a-z0-9-]+/[a-z0-9-]+$",
            "description": "Repository folder of the entry; files are fetched relative to it."
          },
          "size": {
            "type": "integer",
            "minimum": 0,
            "description": "Total size of the entry's files, in bytes."
          }
        },
        "description": "A configuration manifest plus the generated fields. Validate one entry with schema/configuration.schema.json."
      }
    },
    "themes": {
      "type": "array",
      "description": "Declarative interface themes. Each entry points to a TOML manifest and its SHA-256; no code is executed.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "description", "author", "version", "license", "status", "file", "sha256", "size"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[-_][a-z0-9]+)*$" },
          "title": { "type": "string", "minLength": 1, "maxLength": 120 },
          "description": { "type": "string", "minLength": 1 },
          "author": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "github": { "type": "string", "pattern": "^[A-Za-z0-9-]+$" }
            }
          },
          "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
          "license": { "type": "string", "minLength": 1 },
          "status": { "type": "string", "enum": ["proposed", "verified", "experimental", "broken"] },
          "file": { "type": "string", "pattern": "^themes/[a-z0-9_-]+\\.toml$" },
          "sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
          "size": { "type": "integer", "minimum": 1, "maximum": 262144 }
        }
      }
    }
  }
}
